scripts/fixtures/ingest-eval.json
scripts/fixtures/.ingest-eval-luma-cache.json

# generated reports
ga4-dashboard.html

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local Claude Code settings (may contain secrets)
.claude/
